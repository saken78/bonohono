    "@scalar/hono-api-reference": "^0.10.11",
    "hono": "^4.12.14",
    "hono-openapi": "^1.3.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rcmade/hono-docs": "^1.0.32",
    "@types/bun": "^1.3.12",
    "prisma": "^7.7.0"
  },
  "exclude": [
    "generated",
    "node_modules"
