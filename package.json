{
  "name": "bono",
  "scripts": {
    "sh": "bun run --hot src/index.ts",
    "start:hard": "bun run --watch src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "hono": "^4.13.7",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@rcmade/hono-docs": "^1.4.0",
    "@types/bun": "^1.4.1",
    "prisma": "^7.8.0",
    "typescript": "^7.0.2"
  },
  "exclude": [
    "generated",
    "node_modules"
  ]
}
